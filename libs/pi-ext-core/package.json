{
  "name": "@leo-alvarenga/pi-ext-core",
  "version": "0.1.0",
  "description": "Shared building blocks for pi extensions: types, utils, headless agent runtime, session store, panel widget, and subagent runtime",
  "license": "MIT",
  "repository": "github.com/leo-alvarenga/pi-mono",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-extension",
    "pi-package",
    "pi"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/utils/strings.test.ts && tsx src/headless/run.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19",
    "typescript": "^7.0.2"
  }
}
