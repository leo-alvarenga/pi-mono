{
  "name": "@leo-alvarenga/pi-ext-core",
  "version": "0.8.0",
  "description": "Shared building blocks for pi extensions: types, utils, session store, and panel widget",
  "license": "MIT",
  "repository": "github.com/leo-alvarenga/pi-mono",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-extension",
    "pi-package",
    "pi"
  ],
  "files": [
    "src",
    "!src/test",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
