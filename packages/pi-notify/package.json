{
  "name": "@leo-alvarenga/pi-notify",
  "version": "0.2.1",
  "description": "Desktop notification + sound when a Pi prompt settles: D-Bus popup on Linux, opt-in",
  "license": "MIT",
  "repository": "github.com/leo-alvarenga/pi-mono",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-extension",
    "pi-package",
    "pi",
    "notify",
    "notification",
    "dbus",
    "linux"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "!src/*.test.ts"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/core.test.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
