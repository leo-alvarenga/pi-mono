{
  "name": "@leo-alvarenga/pi-zen-frame",
  "description": "A pi-coding-agent extension that gives the TUI editor a simple yet polished look and feel",
  "author": "Leonardo A. Alvarenga",
  "version": "0.13.0",
  "license": "MIT",
  "repository": "github.com/leo-alvarenga/pi-mono",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc"
  },
  "keywords": [
    "pi-extension",
    "pi-package",
    "pi"
  ],
  "files": [
    "extensions",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
