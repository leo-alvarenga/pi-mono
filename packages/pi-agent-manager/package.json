{
  "name": "@leo-alvarenga/pi-agent-manager",
  "version": "0.18.12",
  "description": "A package for managing agents in Pi",
  "license": "MIT",
  "repository": "github.com/leo-alvarenga/pi-mono",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-extension",
    "pi-package",
    "pi"
  ],
  "files": [
    "src",
    "!src/test",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@leo-alvarenga/pi-ext-core": "workspace:^",
    "@earendil-works/pi-tui": "^0.84.0",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
